        "list": {
            "ul": "<li><ul class='group-box list'></ul></li>",
            "li": "<li class='' data-sn='${btn-id}'><div class='tpl-button-box'>${TEXT-INNER}</div></li>"
        },
        "checked": {
            "ul": "<li><ul class='group-box'></ul></li>",
            "li": "<li class='clickable' data-sn='${btn-id}'><div class='tpl-input-box'><input type='checkbox'><p>${TEXT_INNER}</p></div></li>"
        },
        "input": {
            "ul": "<li><ul class='group-box'></ul></li>",
            "li": "<li class='clickable' data-sn='${btn-id}'><div  class='tpl-input-box'><p>Test</p><input type='number'></div></li>"

