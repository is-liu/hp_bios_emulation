            "li":"<li class='clickable' data-sn='${btn-id}'>${TEXT-INNER}</li>"
        },
        "page": {
            "li": "<div class='lt'></div><div class='content' id='${unit-id}'><ul class='group-box'></ul></div>"
        },
        "group": {
            "ul": "<li><ul class='group-box group'></ul></li>",
            "li": "<li class='clickable' data-sn='${btn-id}'><div class='tpl-button-box'>${TEXT-INNER}</div></li>"
