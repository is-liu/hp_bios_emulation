{
    "unit-menu": {
        "type": [""]
    },

    "template": {
        "nav": {
            "li":"<li class='clickable show-descr' data-sn='${btn-id}'>${TEXT-INNER}</li>"
        },
        "page": {
            "li": "<div class='lt'></div><div class='content' id='${unit-id}'><ul class='group-box'></ul></div>"
        },
        "group": {
            "ul": "<li><ul class='group-box group' id='${unit-id}'></ul></li>",
            "li": "<li class='show-descr' data-sn='${btn-id}'><div class='tpl-button-box'>${TEXT-INNER}</div></li>"
        },
        "list": {
            "ul": "<li><ul class='group-box list' id='${unit-id}'></ul></li>",
            "li": "<li class='show-descr' data-sn='${btn-id}' id='${unit-id}'><div class='tpl-button-box'>${TEXT-INNER}</div></li>"
        },
        "checked": {
            "ul": "<li><ul class='group-box'></ul></li>",
            "li": "<li class='show-descr' data-sn='${btn-id}'><div class='tpl-input-box'><input type='checkbox'><p>${TEXT_INNER}</p></div></li>"
        },
        "input-text": {
            "ul": "<li><ul class='group-box' id='${unit-id}'></ul></li>",
            "li": "<li class='show-descr' data-sn='${btn-id}' id='${unit-id}'><div  class='tpl-input-box'><p>Test</p><input type='text'></div></li>"
        },
        "input-number": {
            "ul": "<li><ul class='group-box' id='${unit-id}'></ul></li>",
            "li": "<li class='show-descr' data-sn='${btn-id}' id='${unit-id}'><div  class='tpl-input-box'><p>Test</p><input type='number'></div></li>"
        },
        "promptList": "<li>${TEXT-INNER}</li>",
        "backbtn": "<div class='back-btn'>← 返回上级</div>"
    }
}
